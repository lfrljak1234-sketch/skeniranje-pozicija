# Kopiraj ovu datoteku u ".env" i upiši svoje stvarne vrijednosti
# (samo za lokalno testiranje - .env se NE smije commitati na GitHub).
#
# Na Renderu se ove iste varijable postavljaju u
# Dashboard -> tvoj servis -> Environment -> Add Environment Variable
# (ne stavljaju se u .env datoteku niti u kod).

SUPABASE_URL=https://tvoj-projekt.supabase.co
SUPABASE_SERVICE_KEY=tvoj-service-role-kljuc
